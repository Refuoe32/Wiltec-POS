# Supabase: Project -> Connect -> "Transaction pooler" connection string (port 6543)
# Replace [YOUR-PASSWORD]. If the password has special characters (@ # / :) URL-encode them.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres
# Any long random string (run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
